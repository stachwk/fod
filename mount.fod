#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FOD_BOOTSTRAP_CMD=()

ROLE="${FOD_ROLE:-auto}"
READONLY="${FOD_RUST_FUSE_READONLY:-}"
PROFILE="${FOD_PROFILE:-}"
SELINUX="${FOD_SELINUX:-off}"
ACL="${FOD_ACL:-off}"
ATIME_POLICY="${FOD_ATIME_POLICY:-default}"
DEFAULT_PERMISSIONS="${FOD_DEFAULT_PERMISSIONS:-1}"
ALLOW_OTHER="${FOD_ALLOW_OTHER:-0}"
LOG_LEVEL="${FOD_LOG_LEVEL:-}"
DEBUG="${FOD_DEBUG:-0}"
CONFIG_FILE=""
CONFIG_OPTION_NAME=""
POSITIONAL=()

usage() {
  cat <<'EOF'
Usage:
  mount.fod [source] <mountpoint> [mount-options]

Every mount must explicitly bind one INI file:
  mount.fod /mnt/fod -o ini=/etc/fod/fod.db01.ini,role=auto

With the system mount command:
  mount -t fod none /mnt/fod -o ini=/etc/fod/fod.db01.ini,_netdev

The legacy config= and fod_config= aliases remain accepted temporarily but emit
a deprecation warning. FOD_CONFIG and implicit ./fod_config.ini lookup are not
accepted as a substitute for the required mount option.

Unrecognized FOD-like options print a warning to stderr instead of failing
silently. System passthrough options such as _netdev, nofail, and x-systemd.*
are still ignored.
EOF
}

ensure_mountpoint_dir() {
  if [[ -e "${MOUNTPOINT}" ]]; then
    if [[ ! -d "${MOUNTPOINT}" ]]; then
      echo "mount.fod: mountpoint ${MOUNTPOINT} exists but is not a directory" >&2
      exit 2
    fi
    return 0
  fi

  mkdir -p "${MOUNTPOINT}"
}

find_checkout_root() {
  local start_dir="$1"
  local dir

  dir="$(cd "${start_dir}" && pwd)"
  while [[ -n "${dir}" ]]; do
    if [[ -f "${dir}/Cargo.toml" && -f "${dir}/fod_version.txt" && -f "${dir}/mount.fod" ]]; then
      echo "${dir}"
      return 0
    fi
    if [[ "${dir}" == "/" ]]; then
      break
    fi
    dir="$(dirname "${dir}")"
  done

  return 1
}

resolve_bootstrap_bin() {
  local debug_mode="$1"
  local project_root="$2"
  local -a candidates=()

  if [[ -n "${FOD_BOOTSTRAP_BIN:-}" && -x "${FOD_BOOTSTRAP_BIN}" ]]; then
    echo "${FOD_BOOTSTRAP_BIN}"
    return 0
  fi

  if [[ -n "${project_root}" ]]; then
    if [[ "${debug_mode}" != "0" ]]; then
      candidates=(
        "${project_root}/target/debug/fod-bootstrap"
        "${project_root}/target/release/fod-bootstrap"
        "${project_root}/rust_mkfs/target/debug/fod-bootstrap"
        "${project_root}/rust_mkfs/target/release/fod-bootstrap"
      )
    else
      candidates=(
        "${project_root}/target/release/fod-bootstrap"
        "${project_root}/target/debug/fod-bootstrap"
        "${project_root}/rust_mkfs/target/release/fod-bootstrap"
        "${project_root}/rust_mkfs/target/debug/fod-bootstrap"
      )
    fi
  fi

  for candidate in "${candidates[@]}"; do
    if [[ -x "${candidate}" ]]; then
      echo "${candidate}"
      return 0
    fi
  done

  if command -v fod-bootstrap >/dev/null 2>&1; then
    echo "$(command -v fod-bootstrap)"
    return 0
  fi

  if [[ -x "/usr/local/bin/fod-bootstrap" ]]; then
    echo "/usr/local/bin/fod-bootstrap"
    return 0
  fi

  return 1
}

translate_option() {
  local opt="$1"
  case "${opt}" in
    role=*)
      ROLE="${opt#role=}"
      ;;
    profile=*)
      PROFILE="${opt#profile=}"
      ;;
    selinux=*)
      SELINUX="${opt#selinux=}"
      ;;
    acl=*)
      ACL="${opt#acl=}"
      ;;
    atime-policy=*)
      ATIME_POLICY="${opt#atime-policy=}"
      ;;
    noatime|nodiratime|relatime|strictatime)
      ATIME_POLICY="${opt}"
      ;;
    default_permissions|default-permissions)
      DEFAULT_PERMISSIONS=1
      ;;
    no_default_permissions|no-default-permissions)
      DEFAULT_PERMISSIONS=0
      ;;
    allow_other|allow-other)
      ALLOW_OTHER=1
      ;;
    no_allow_other|no-allow-other)
      ALLOW_OTHER=0
      ;;
    debug)
      DEBUG=1
      ;;
    log-level=*)
      LOG_LEVEL="${opt#log-level=}"
      ;;
    ini=*)
      CONFIG_FILE="${opt#ini=}"
      CONFIG_OPTION_NAME="ini"
      ;;
    config=*)
      CONFIG_FILE="${opt#config=}"
      CONFIG_OPTION_NAME="config"
      echo "mount.fod: option 'config=' is deprecated; use 'ini='" >&2
      ;;
    fod_config=*)
      CONFIG_FILE="${opt#fod_config=}"
      CONFIG_OPTION_NAME="fod_config"
      echo "mount.fod: option 'fod_config=' is deprecated; use 'ini='" >&2
      ;;
    ro)
      READONLY="1"
      ;;
    rw)
      READONLY="0"
      ;;
    *)
      warn_unknown_option "${opt}"
      ;;
  esac
}

warn_unknown_option() {
  local opt="$1"
  case "${opt}" in
    _netdev|nofail|fail|defaults|ro|rw|user|users|owner|group|exec|noexec|suid|nosuid|dev|nodev|sync|async|lazytime|dirsync|acl|noacl|user_xattr|nouser_xattr|x-systemd.*|x-mount.*|comment=*|context=*|fscontext=*|defcontext=*|rootcontext=*|uid=*|gid=*|umask=*|dmask=*|fmask=*|subtype=*|size=*|mode=*|shortname=*|iocharset=*|utf8|codepage=*|blocksize=*|loop|bind|rbind|move|remount)
      return
      ;;
  esac
  echo "mount.fod: ignoring unrecognized option '${opt}'; FOD options include ini=/absolute/path.ini, role=..., selinux=..., acl=..., atime-policy=..." >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -o)
      shift
      if [[ $# -eq 0 ]]; then
        echo "mount.fod: missing argument after -o" >&2
        exit 2
      fi
      IFS=',' read -r -a OPTS <<< "$1"
      for opt in "${OPTS[@]}"; do
        [[ -n "$opt" ]] && translate_option "$opt"
      done
      ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      ;;
    *)
      POSITIONAL+=("$1")
      ;;
  esac
  shift
done

if [[ ${#POSITIONAL[@]} -lt 1 ]]; then
  usage >&2
  exit 2
fi

MOUNTPOINT="${POSITIONAL[-1]}"

if [[ -z "${CONFIG_FILE}" ]]; then
  echo "mount.fod: missing required mount option 'ini=/absolute/path/to/fod.ini'" >&2
  exit 2
fi
if [[ "${CONFIG_FILE}" != /* ]]; then
  echo "mount.fod: ini path must be absolute: ${CONFIG_FILE}" >&2
  exit 2
fi
if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "mount.fod: ini file does not exist or is not a regular file: ${CONFIG_FILE}" >&2
  exit 2
fi
if [[ ! -r "${CONFIG_FILE}" ]]; then
  echo "mount.fod: ini file is not readable: ${CONFIG_FILE}" >&2
  exit 2
fi
CONFIG_DIR="$(cd -P -- "$(dirname -- "${CONFIG_FILE}")" && pwd)"
CONFIG_FILE="${CONFIG_DIR}/$(basename -- "${CONFIG_FILE}")"

export FOD_ROLE="${ROLE}"
if [[ -n "${READONLY}" ]]; then
  export FOD_RUST_FUSE_READONLY="${READONLY}"
fi
if [[ -n "${PROFILE}" ]]; then
  export FOD_PROFILE="${PROFILE}"
fi
export FOD_USE_FUSE_CONTEXT="1"
export FOD_SELINUX="${SELINUX}"
export FOD_ACL="${ACL}"
export FOD_ATIME_POLICY="${ATIME_POLICY}"
export FOD_DEFAULT_PERMISSIONS="${DEFAULT_PERMISSIONS}"
export FOD_ALLOW_OTHER="${ALLOW_OTHER}"
if [[ -n "${LOG_LEVEL}" ]]; then
  export FOD_LOG_LEVEL="${LOG_LEVEL}"
fi
export FOD_CONFIG="${CONFIG_FILE}"
if [[ "${DEBUG}" != "0" ]]; then
  export FOD_DEBUG="1"
fi

PROJECT_ROOT=""
if PROJECT_ROOT="$(find_checkout_root "${PWD}" 2>/dev/null)"; then
  :
elif PROJECT_ROOT="$(find_checkout_root "${SCRIPT_DIR}" 2>/dev/null)"; then
  :
else
  PROJECT_ROOT=""
fi

resolved_bootstrap="$(resolve_bootstrap_bin "${DEBUG}" "${PROJECT_ROOT}")" || {
  echo "mount.fod: fod-bootstrap not found in the project tree, PATH, or /usr/local/bin. Build target/{debug,release}/fod-bootstrap first." >&2
  exit 2
}
FOD_BOOTSTRAP_CMD=("${resolved_bootstrap}")


ensure_mountpoint_dir

FOD_ARGS=("-f" "${MOUNTPOINT}" "--config" "${CONFIG_FILE}")
if [[ -n "${PROFILE}" ]]; then
  FOD_ARGS+=("--profile" "${PROFILE}")
fi

exec "${FOD_BOOTSTRAP_CMD[@]}" "${FOD_ARGS[@]}"
